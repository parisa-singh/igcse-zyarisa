rules_version = '2';

// ── IGCSE Playbook — Firestore security rules ────────────────────────────────
// Locks the shared tracker data to specific Google accounts.
//   editors  → can READ and WRITE every tracker + write the activity feed
//   viewers  → can READ everything, but cannot change anything (e.g. parents)
//   everyone else (and anyone not signed in) → no access at all.
//
// HOW TO PUBLISH:
//   Firebase console → Build → Firestore Database → Rules tab →
//   paste this whole file over what's there → Publish.
//
// TO ADD SOMEONE: add their lowercase Gmail to editors() or viewers() below,
// re-Publish here, AND add the same email to /assets/js/firebase-config.js.
// (Both must match: this file is the real lock; the JS file is only for the UI.)

service cloud.firestore {
  match /databases/{database}/documents {

    // 🔑 EDIT THESE TWO LISTS. Keep in sync with assets/js/firebase-config.js.
    function editors() {
      return [
        'parisasingh@gmail.com'                  // ← you (owner).
        // , 'her-new-gmail@gmail.com'            // ← your sister, once you have her address.
      ];
    }
    function viewers() {
      return [
        // 'mom@gmail.com',
        // 'dad@gmail.com'
      ];
    }

    // A signed-in account with a verified email.
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isEditor() {
      return signedIn() && (request.auth.token.email in editors());
    }
    // Editors are also allowed to read, so viewer-read = editor OR viewer.
    function canRead() {
      return signedIn() && (
        request.auth.token.email in editors() ||
        request.auth.token.email in viewers()
      );
    }

    match /trackers/{slug} {
      allow read:  if canRead();
      allow write: if isEditor();
    }

    match /activity/{entry} {
      allow read:   if canRead();
      allow create: if isEditor();
      allow update, delete: if false;   // activity feed is append-only
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
