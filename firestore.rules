rules_version = '2';

// ── IGCSE Playbook — Firestore security rules (TEMPLATE) ─────────────────────
// ⚠️ This repo file is PUBLIC — keep it a template with NO real emails.
// The LIVE rules (with the real family emails) live only in the Firebase console:
//     Firebase console → Build → Firestore Database → Rules tab → paste → Publish.
// That console copy is private; this file is just a reference for the structure.
//
//   editors → can READ and WRITE every tracker + write the activity feed
//   viewers → can READ everything, but cannot change anything (e.g. parents)
//   everyone else (and anyone not signed in) → no access at all.
//
// The app has no email list; it detects each person's role from these rules:
//   probe write allowed → editor · tracker read allowed → viewer · neither → denied.
//
// TO ADD SOMEONE: edit the console copy's editors()/viewers() list → Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    // 🔑 In the CONSOLE copy, put the real lowercase Gmail addresses here.
    function editors() {
      return [
        'owner@example.com'      // ← replace in console with the editors' real emails
      ];
    }
    function viewers() {
      return [
        // 'viewer@example.com'  // ← replace in console with the viewers' real emails
      ];
    }

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isEditor() {
      return signedIn() && (request.auth.token.email in editors());
    }
    function canRead() {
      return signedIn() && (
        request.auth.token.email in editors() ||
        request.auth.token.email in viewers()
      );
    }

    match /trackers/{slug} {
      allow read:  if canRead();
      allow write: if isEditor();
    }

    match /activity/{entry} {
      allow read:   if canRead();
      allow create: if isEditor();
      allow update, delete: if false;   // append-only
    }

    // Write-only probe the app uses once to detect editor rights.
    match /probe/{uid} {
      allow read: if false;
      allow write: if isEditor() && request.auth.uid == uid;
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
